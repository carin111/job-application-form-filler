{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private experience index",
  "type": "object",
  "required": [
    "experiences"
  ],
  "properties": {
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "file",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "integer"
          },
          "role_priority": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
